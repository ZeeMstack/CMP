# Local development only — never commit a real .env.
# DATABASE_URL's user/password/db/port must stay consistent with the
# POSTGRES_* values in the root .env.example (used by compose.yaml).
ENV=development
DATABASE_URL=postgresql+psycopg://cmp:cmp@localhost:5432/cmp
DB_CONNECT_TIMEOUT_SECONDS=5

# TEMPORARY, development-only. Must never be true outside ENV=development —
# the app refuses to start otherwise. Enables X-Dev-Tenant-Id/X-Dev-User-Id
# header auth and the /dev/bootstrap/* routes, in place of OIDC.
ENABLE_DEV_AUTH=false

# Used only by the integration test suite — never the app itself. Points at a
# separate database in the same local Postgres instance so tests never touch
# the development "cmp" database.
TEST_DATABASE_URL=postgresql+psycopg://cmp:cmp@localhost:5432/cmp_test

# --- Production/pilot bearer-auth (Auth0) ------------------------------
#
# Required whenever ENV != "development" — the app refuses to start
# without all three (app/core/settings.py::check_oidc_startup_invariant).
# Verifies API *access* tokens for the CMP API's own resource audience
# (never an ID token, never a frontend client ID) — see app/core/oidc.py.
#
# OIDC_ISSUER               The OIDC issuer URL, e.g. https://<tenant>.us.auth0.com/
# OIDC_AUDIENCE             The CMP API's own Auth0 API audience identifier —
#                           must exactly match apps/web's CMP_API_AUDIENCE.
# OIDC_JWKS_URL             The issuer's JWKS endpoint, e.g.
#                           https://<tenant>.us.auth0.com/.well-known/jwks.json
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Optional — defaults shown are production-safe as-is. OIDC_ALLOWED_ALGORITHMS
# is parsed as JSON and may only contain asymmetric algorithms (RS256/RS384/
# RS512/PS256/PS384/PS512/ES256/ES384/ES512/EdDSA) — "none" and any HS*
# algorithm are rejected regardless of what is set here.
# OIDC_ALLOWED_ALGORITHMS=["RS256"]
# OIDC_CLOCK_SKEW_SECONDS=60
# OIDC_JWKS_CACHE_TTL_SECONDS=300
# OIDC_JWKS_MIN_REFRESH_INTERVAL_SECONDS=30

# --- Production database TLS --------------------------------------------
#
# A managed PostgreSQL provider (e.g. DigitalOcean) requires TLS. No code
# change is needed: append sslmode (and, for sslmode=verify-full, sslrootcert)
# directly to DATABASE_URL's query string, e.g.:
#   postgresql+psycopg://<user>:<password>@<host>:<port>/<db>?sslmode=verify-full&sslrootcert=/path/to/ca.crt
# See docs/deployment/PILOT_DEPLOYMENT.md, "Database", for the full contract
# (sslmode=verify-full preferred; sslmode=require is the documented minimum
# if certificate handling proves impractical for the initial pilot).
