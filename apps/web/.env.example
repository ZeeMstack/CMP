# Server-only environment variables. See lib/server/auth0.ts,
# lib/server/auth-mode.ts, and app/api/[...path]/route.ts.
#
# Never prefix any of these with NEXT_PUBLIC_ -- they must never reach
# browser JavaScript. This file is tracked in Git: it must only ever
# contain variable names and placeholders, never real secrets or
# production values.
#
# CMP_API_BASE_URL   Base URL of the FastAPI backend this proxy forwards
#                     GET requests to.

CMP_API_BASE_URL=http://localhost:8000

# --- Real authentication (Auth0) ---------------------------------------
#
# Required in real-auth mode (i.e. whenever CMP_DEV_AUTH_BYPASS is not
# active -- see below). Real values are provisioned in AUTH-001C; this
# ticket (AUTH-001B1) only wires up the code that reads them. Names match
# the canonical environment variables @auth0/nextjs-auth0 itself reads
# when Auth0Client() is constructed without explicit options -- do not
# invent different names for these.
#
# AUTH0_DOMAIN          Auth0 tenant domain (e.g. your-tenant.us.auth0.com).
# AUTH0_CLIENT_ID       Auth0 application client ID.
# AUTH0_CLIENT_SECRET   Auth0 application client secret.
# AUTH0_SECRET          32-byte hex secret used to encrypt the session
#                       cookie. Generate with: openssl rand -hex 32
# APP_BASE_URL          This application's own base URL (e.g.
#                       http://localhost:3000), used to build the
#                       callback/redirect URLs.
# CMP_API_AUDIENCE      The CMP API's OIDC audience identifier -- must
#                       exactly match the backend's OIDC_AUDIENCE
#                       (apps/api/.env).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
CMP_API_AUDIENCE=

# --- Development-only auth bypass --------------------------------------
#
# INTERNAL DEVELOPMENT ONLY -- NOT AUTHENTICATION. Lets CMP run locally
# without a configured Auth0 tenant, by reusing the backend's existing
# dev-auth mechanism (X-Dev-Tenant-Id / X-Dev-User-Id). Fails closed if
# CMP_DEV_AUTH_BYPASS=true is set while NODE_ENV=production (see
# lib/server/auth-mode.ts) -- this can never become a production
# authentication path.
#
# CMP_DEV_AUTH_BYPASS   Set to the literal string "true" to activate.
# CMP_DEV_TENANT_ID     UUID of an active tenant in the dev backend.
# CMP_DEV_USER_ID       UUID of an active user with an active membership
#                       in the tenant above.
CMP_DEV_AUTH_BYPASS=
CMP_DEV_TENANT_ID=
CMP_DEV_USER_ID=

# --- Test-only auth bypass (Playwright) --------------------------------
#
# TEST EXECUTION ONLY -- set only by playwright.config.ts's webServer
# env, never by a developer's own .env.local and never in any deployed
# environment. Deliberately a distinct mechanism from CMP_DEV_AUTH_BYPASS
# so that Playwright's production-shaped build (`next build && next
# start`, NODE_ENV=production) can still run deterministically without
# ever weakening the dev-bypass production invariant above. The value
# must be the exact literal string below -- not a plain boolean -- so it
# cannot be enabled by accident.
#
# CMP_TEST_AUTH_BYPASS   Must equal exactly: playwright-e2e-only
# CMP_TEST_TENANT_ID     UUID used only by the Playwright fixture data.
# CMP_TEST_USER_ID       UUID used only by the Playwright fixture data.
CMP_TEST_AUTH_BYPASS=
CMP_TEST_TENANT_ID=
CMP_TEST_USER_ID=
