# Server-only environment variables for the FE-001 read-only pilot proxy.
# See lib/server/pilot-identity.ts and app/api/[...path]/route.ts.
#
# INTERNAL PILOT ONLY -- NOT AUTHENTICATION. CMP_PILOT_TENANT_ID and
# CMP_PILOT_USER_ID are a fixed dev-auth identity shared by every user of
# this deployment; they must be replaced with real authentication before
# any write/mutation workflow ships or any external user gets access.
#
# Never prefix these with NEXT_PUBLIC_ -- they must never reach browser
# JavaScript. This file is tracked in Git: it must only ever contain
# variable names and placeholders, never real secrets or production values
# (no real UUIDs, no passwords, no API keys, no tenant-specific IDs).
#
# CMP_API_BASE_URL     Base URL of the FastAPI backend this proxy forwards
#                      GET requests to.
# CMP_PILOT_TENANT_ID  UUID of an active tenant in that backend, used as
#                      the fixed internal-pilot identity.
# CMP_PILOT_USER_ID    UUID of an active user with an active membership in
#                      the tenant above.
CMP_API_BASE_URL=http://localhost:8000
CMP_PILOT_TENANT_ID=
CMP_PILOT_USER_ID=
